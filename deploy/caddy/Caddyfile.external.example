# Use this when Caddy runs on the Docker host instead of inside this Compose project.
# Keep WebDAV on a dedicated virtual host; avoid handle_path/strip_prefix rewrites.

dav.example.com {
  encode gzip

  reverse_proxy 127.0.0.1:5227 {
    # SFTPGo WebDAV needs Host preservation for COPY/MOVE semantics.
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
  }
}
