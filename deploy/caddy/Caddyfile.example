{
  # Configure global trusted_proxies here if Caddy sits behind another proxy/CDN.
  # servers {
  #   trusted_proxies static private_ranges
  # }
}

{$PUBLIC_WEBDAV_HOST} {
  encode gzip

  reverse_proxy sftpgo:8090 {
    # Caddy preserves Host by default; keep this explicit for WebDAV reviewability.
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
  }
}
